{
  "name": "azure-functions-templates-build",
  "version": "0.0.0",
  "description": "Build tools for Azure Functions Templates",
  "author": "Microsoft",
  "license": "MIT",
  "private": true,
  "scripts": {
    "bundle": "gulp build-production",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "ts-node -r tsconfig-paths/register src/server.ts",
    "start:topdev": "npm run build:resources && nodemon",
    "start:dev": "nodemon",
    "start:debug": "nodemon --config nodemon-debug.json",
    "prestart:prod": "rimraf dist && npm run build",
    "start:prod": "node dist/server.js",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "build:resources": "gulp build-all"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.16.0",
    "@azure/storage-file-share": "^12.16.0",
    "@nestjs/common": "^10.4.17",
    "@nestjs/core": "^10.4.3",
    "@nestjs/platform-express": "^10.4.18",
    "applicationinsights": "^2.9.2",
    "async-file": "^2.0.2",
    "axios": "^1.8.3",
    "cache-manager": "^2.9.0",
    "cookie-parser": "^1.4.4",
    "cookie-session": "^1.3.3",
    "dotenv": "^8.0.0",
    "express-csrf": "^0.3.4",
    "express-rate-limit": "^3.5.0",
    "gulp-cli": "^3.0.0",
    "helmet": "^3.18.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.0.0",
    "react": "^16.8.6",
    "react-dom": "^16.8.6",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "del": "^4.1.1",
    "gulp": "^4.0.1",
    "gulp-decompress": "^3.0.0",
    "gulp-json-editor": "^2.6.0",
    "gulp-merge-json": "^2.2.1",
    "gulp-nuget": "^1.3.0",
    "gulp-rename": "^1.4.0",
    "gulp-string-replace": "^1.1.2",
    "gulp-token-replace": "^1.1.5",
    "gulp-zip": "^5.1.0",
    "merge-stream": "^2.0.0",
    "request": "^2.88.2",
    "resx": "^2.0.4",
    "rimraf": "^2.6.3",
    "through2": "^4.0.2",
    "typescript": "^4.9.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
